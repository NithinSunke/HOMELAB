# Shared bearer token for the API. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
RMAN_CONSOLE_TOKEN=change-me

# SQLite database file
RMAN_CONSOLE_DB=/home/user/rman-console/rman_console.db

# known_hosts used to verify target host keys. Unknown hosts are rejected.
RMAN_CONSOLE_KNOWN_HOSTS=/home/oracle/.ssh/known_hosts

# Working directory created on each target host
RMAN_CONSOLE_REMOTE_DIR=/tmp/rman-console
