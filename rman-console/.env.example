# Shared bearer token for the API. The app refuses every request until this
# is set. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RMAN_CONSOLE_TOKEN=change-me

# Everything below is optional. Leave a setting commented out to use its
# default, which is correct on both Windows and Linux.

# Where to keep the SQLite file holding targets and job history.
# Default: rman_console.db in this project folder.
#   Windows: RMAN_CONSOLE_DB=D:/rman-console-data/rman_console.db
#   Linux:   RMAN_CONSOLE_DB=/var/lib/rman-console/rman_console.db

# known_hosts file used to verify target host keys. Unknown hosts are
# rejected, so every target must appear here.
# Default: the current user's ~/.ssh/known_hosts, which resolves to
#   C:\Users\<you>\.ssh\known_hosts on Windows.
#   RMAN_CONSOLE_KNOWN_HOSTS=C:/Users/you/.ssh/known_hosts

# Working directory created on each target host. This is a path on the
# Linux database server, never on the machine running this app.
#   RMAN_CONSOLE_REMOTE_DIR=/tmp/rman-console

# Seconds between polls of the remote RMAN log.
#   RMAN_CONSOLE_POLL_INTERVAL=2

# Hours before the app stops following a job. The backup itself keeps
# running on the target.
#   RMAN_CONSOLE_JOB_TIMEOUT_HOURS=24
